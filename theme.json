{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1140px" },
		"color": {
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#fafaf9" },
				{ "slug": "contrast", "name": "Contrast", "color": "#1c1917" },
				{ "slug": "accent", "name": "Accent", "color": "#4f46e5" },
				{ "slug": "muted", "name": "Muted", "color": "#e7e5e4" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "slug": "system", "name": "System", "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" },
				{ "slug": "serif", "name": "Serif", "fontFamily": "Georgia, 'Times New Roman', serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem" },
				{ "slug": "large", "name": "Large", "size": "clamp(1.5rem, 2vw + 1rem, 2rem)" },
				{ "slug": "x-large", "name": "Extra Large", "size": "clamp(2.25rem, 4vw + 1rem, 3.75rem)" }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "2rem" },
				{ "slug": "50", "name": "L", "size": "4rem" },
				{ "slug": "60", "name": "XL", "size": "6rem" }
			]
		}
	},
	"styles": {
		"spacing": { "padding": { "left": "var(--wp--preset--spacing--30)", "right": "var(--wp--preset--spacing--30)" } },
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--system)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.7" },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "lineHeight": "1.2" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--accent)", "text": "#ffffff" },
				"border": { "radius": "6px" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } }
			}
		},
		"blocks": {
			"core/site-title": { "typography": { "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--large)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
